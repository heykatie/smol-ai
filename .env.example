# Copy to .env and fill in locally. Do not commit .env.
# The local server reads .env on startup and does not print these values.
# When a Vercel project exists, set the same names in its environment. Do not commit .env.

# Anonymous sponsor calls stay off unless SMOL_SPONSOR_CALLS=1
# and both limits below are positive integers.
SMOL_SPONSOR_CALLS=
SMOL_SPONSOR_SESSION_LIMIT=
SMOL_SPONSOR_GLOBAL_LIMIT=
SMOL_DEMO_TTL_SECONDS=86400

# Neon Postgres. Leave empty to keep the local demo on SQLite.
# Vercel sets this when the database is connected. Do not commit a real value.
DATABASE_URL=

# Novita — synthetic supplier-email lead times. Optional. A key alone does not call Novita.
# Prices and approval stay in application code.
NOVITA_API_KEY=
# NOVITA_MODEL=deepseek/deepseek-v4.1-flash

# Tavily — public source links for the fictional reorder. Optional.
TAVILY_API_KEY=

# ZooWork — operations agent. Requires a funded organization balance before a live task.
# The API key already selects the project. The project id is only a local label.
ZOOWORK_API_KEY=
ZOOWORK_PROJECT_ID=
# Durable agent created for this app. Leave empty until that agent exists.
ZOOWORK_AGENT_ID=

# Moss — retrieval of fictional policy text. Both values are required.
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=

# BAND — user key lists and registers agents. Agent keys are created later and shown once.
BAND_USER_KEY=
BAND_RESEARCH_AGENT_ID=
BAND_RESEARCH_AGENT_KEY=
BAND_CLERK_AGENT_ID=
BAND_CLERK_AGENT_KEY=
